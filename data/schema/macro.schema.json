{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "macro.schema.json",
  "title": "macro.json (data contract v2 draft)",
  "type": "object",
  "additionalProperties": false,
  "required": ["dgs10", "sector_medians"],
  "properties": {
    "dgs10": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "date", "source"],
      "properties": {
        "value": { "type": "number", "description": "Decimal, 0.042 = 4.2%." },
        "date": { "type": "string", "format": "date" },
        "source": { "type": "string" }
      }
    },
    "sector_medians": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["margin_mean", "margin_change_mean", "margin_change_sd", "revenue_growth_median"],
        "properties": {
          "margin_mean": { "type": "number" },
          "margin_change_mean": { "type": "number" },
          "margin_change_sd": { "type": "number", "minimum": 0 },
          "revenue_growth_median": { "type": "number" }
        }
      }
    }
  }
}
